<?xml version="1.0"?>
<package format="2">
  <name>real_flight_bringup</name>
  <version>0.0.1</version>
  <description>Bringup package for real-flight pipeline without MuJoCo simulation bridge.</description>

  <maintainer email="user@example.com">real_flight_user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>mavros_msgs</build_depend>
  <build_depend>quadrotor_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
  <exec_depend>imu_mocap_fusion</exec_depend>
  <exec_depend>external_wrench_estimation</exec_depend>
  <exec_depend>intention_get_corridor</exec_depend>
  <exec_depend>traj_gen_in_corridor</exec_depend>
  <exec_depend>px4ctrl</exec_depend>

  <export/>
</package>
