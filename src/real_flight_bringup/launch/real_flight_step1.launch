<?xml version="1.0" encoding="utf-8"?>
<launch>
    <arg name="enable_goal_publish" default="true" />
    <arg name="enable_rviz_goal" default="true" />
    <arg name="rviz_goal_z" default="1.0" />
    <arg name="enable_nmpc" default="true" />
    <arg name="lidar_odom_topic" default="/aft_mapped_to_init" />
    <arg name="lidar_to_body_pitch_deg" default="-25.3" />
    <arg name="point_cloud_use_pcd" default="false" />
    <arg name="online_map_topic" default="/rm_node/rog_map/occ" />
    <arg name="online_map_update_period" default="0.5" />
    <arg name="online_replan_period" default="1.0" />
    <arg name="mpd_model_dir" default="$(env HOME)/mpd_splines/small" />
    <arg name="engine_collision_bs72" default="$(arg mpd_model_dir)/best_model_multimat.engine" />
    <arg name="engine_collision_bs1" default="$(arg mpd_model_dir)/best_model_multimat_bs1.engine" />
    <arg name="engine_student" default="$(arg mpd_model_dir)/student_distilled.engine" />
    <arg name="use_cuda_graph" default="true" />
    <arg name="verbose_timing" default="false" />
    <arg name="pointseq_topic" default="/real/MyPointSeq" />
    <arg name="ext_force_topic" default="/real/external_force_est" />
    <arg name="use_external_force_collision_hold" default="false" />
    <arg name="use_time_based_collision_end_trigger" default="false" />
    <arg name="enable_pre_align" default="true" />
    <arg name="pre_align_altitude" default="1.40" />
    <arg name="offboard_wait_timeout_sec" default="0.0" />
    <arg name="pre_align_timeout_sec" default="20.0" />
    <arg name="pre_align_cmd_topic" default="/position_command" />

    <!-- Global shared params -->
    <rosparam file="$(find real_flight_bringup)/config/vehicle.yaml" command="load" />
    <rosparam file="$(find real_flight_bringup)/config/mission.yaml" command="load" />

    <!-- 1) Point-LIO localization. -->
    <include file="$(find real_flight_bringup)/launch/localization.launch">
        <arg name="lidar_odom_topic" value="$(arg lidar_odom_topic)" />
        <arg name="lidar_to_body_pitch_deg" value="$(arg lidar_to_body_pitch_deg)" />
    </include>

    <!-- 2) External wrench estimation from fused state + ESC -->
    <node pkg="external_wrench_estimation" type="external_wrench_estimation_node"
          name="external_wrench_estimation" output="screen">
        <param name="cfgPath" value="$(find real_flight_bringup)/config/external_wrench_estimation_real.yaml" />
        <remap from="~imf" to="/estimator/state" />
        <remap from="~rmu" to="/mavros/esc_status" />
        <remap from="~ewe" to="/external_wrench_estimation/ewe_out" />
        <remap from="~eweBias" to="/external_wrench_estimation/ewe_bias_out" />
    </node>

    <!-- Convert WrenchStamped to Vector3Stamped for existing planner/traj_server -->
    <node pkg="real_flight_bringup" type="wrench_to_force_vector.py"
          name="wrench_to_force_vector" output="screen">
        <param name="input_wrench_topic" value="/external_wrench_estimation/ewe_out" />
                <param name="output_force_topic" value="$(arg ext_force_topic)" />
        <param name="output_frame_id" value="world" />
    </node>

    <!-- 前端规划器：默认接收 ROG-Map 在线占据点云，并随地图更新重规划。 -->
    <node pkg="intention_get_corridor" type="intention_get_corridor_node"
          name="intention_get_corridor" output="screen">
        <param name="RunInConsole" type="bool" value="0" />
                                <remap from="/MyPointSeq" to="$(arg pointseq_topic)" />
                                <remap from="/external_force_est" to="$(arg ext_force_topic)" />
                <param name="engine_collision_bs72" value="$(arg engine_collision_bs72)" />
                <param name="engine_collision_bs1" value="$(arg engine_collision_bs1)" />
                <param name="engine_student" value="$(arg engine_student)" />
                <param name="use_cuda_graph" value="$(arg use_cuda_graph)" />
                <param name="verbose_timing" value="$(arg verbose_timing)" />
        <param name="use_time_based_collision_end_trigger" value="$(arg use_time_based_collision_end_trigger)" />
        <rosparam file="$(find real_flight_bringup)/config/intention_real.yaml" command="load" />
        <rosparam file="$(find real_flight_bringup)/config/mission.yaml" command="load" />
        <param name="PointCloudUsePCD" type="bool" value="$(arg point_cloud_use_pcd)" />
        <param name="OnlineMapTopic" value="$(arg online_map_topic)" />
        <param name="OnlineMapUpdatePeriod" type="double" value="$(arg online_map_update_period)" />
        <param name="OnlineReplanPeriod" type="double" value="$(arg online_replan_period)" />
    </node>

    <!-- Trajectory generation -->
    <node pkg="traj_gen_in_corridor" type="traj_gen_in_corridor_node"
          name="traj_gen_in_corridor" output="screen">
                <remap from="/MyPointSeq" to="$(arg pointseq_topic)" />
                <param name="engine_collision_bs72" value="$(arg engine_collision_bs72)" />
                <param name="engine_collision_bs1" value="$(arg engine_collision_bs1)" />
                <param name="engine_student" value="$(arg engine_student)" />
                <param name="use_cuda_graph" value="$(arg use_cuda_graph)" />
                <param name="verbose_timing" value="$(arg verbose_timing)" />
        <rosparam file="$(find real_flight_bringup)/config/traj_gen_real.yaml" command="load" />
    </node>

    <!-- Polynomial trajectory sampler -> PositionCommand -->
    <node pkg="real_flight_bringup" type="polytraj_poscmd_bridge_node" name="polytraj_poscmd_bridge" output="screen">
        <rosparam file="$(find real_flight_bringup)/config/polytraj_poscmd_bridge.yaml" command="load" />
        <param name="cmd_topic" value="/position_command" />
        <param name="ext_force_topic" value="$(arg ext_force_topic)" />
        <!-- 保持原实验逻辑：连续跟踪碰撞前、碰撞过渡和碰撞后轨迹，
             只把下游轨迹跟踪器替换为 NMPC。 -->
        <param name="use_external_force_collision_hold" value="$(arg use_external_force_collision_hold)" />
    </node>

    <!-- Goal trigger (endpoint is read from /SetPos in mission.yaml) -->
    <node if="$(arg enable_goal_publish)" pkg="real_flight_bringup" type="publish_goal_once.py"
          name="publish_goal_once" output="screen">
        <param name="setpos_param" value="/SetPos" />
        <param name="topic" value="/goal" />
        <param name="frame_id" value="world" />
        <param name="delay_sec" value="3.0" />
        <param name="repeat_count" value="5" />
        <param name="repeat_hz" value="10.0" />
        <param name="enable_pre_align" value="$(arg enable_pre_align)" />
        <param name="wait_offboard" value="true" />
        <param name="wait_for_fsm_hover" value="true" />
        <param name="fsm_command_topic" value="/fsm_ctrl/command" />
        <param name="offboard_wait_timeout_sec" value="$(arg offboard_wait_timeout_sec)" />
        <param name="state_topic" value="/mavros/state" />
        <param name="odom_topic" value="/visual_slam/odom" />
        <param name="pre_align_cmd_topic" value="$(arg pre_align_cmd_topic)" />
        <param name="pre_align_altitude" value="$(arg pre_align_altitude)" />
        <param name="pre_align_rate_hz" value="30.0" />
        <param name="pre_align_hold_sec" value="0.8" />
        <param name="pre_align_timeout_sec" value="$(arg pre_align_timeout_sec)" />
        <param name="pre_align_z_tolerance" value="0.15" />
        <param name="pre_align_att_tolerance" value="0.20" />
        <param name="pre_align_blind_publish_sec" value="1.0e9" />
        <param name="odom_wait_timeout_sec" value="$(arg pre_align_timeout_sec)" />
    </node>

    <!-- RViz 的 2D Nav Goal 没有高度；转换后发布给在线规划器 /goal。 -->
    <node if="$(arg enable_rviz_goal)" pkg="real_flight_bringup" type="rviz_goal_bridge.py"
          name="rviz_goal_bridge" output="screen">
        <param name="input_topic" value="/move_base_simple/goal" />
        <param name="output_topic" value="/goal" />
        <param name="goal_z" value="$(arg rviz_goal_z)" />
        <param name="frame_id" value="world" />
    </node>

    <!-- Primary low-level controller: Jiangyin FSM + NMPC. cmd5 tracks /position_command. -->
    <node if="$(arg enable_nmpc)" pkg="fsm_ctrl" type="single_offboard_fsm"
          name="single_offboard_fsm" output="screen">
        <rosparam command="load" file="$(find real_flight_bringup)/config/nmpc.yaml" />
        <param name="nmpc_hover_z" value="$(arg pre_align_altitude)" />
    </node>

</launch>
