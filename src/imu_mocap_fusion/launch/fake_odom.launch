<launch>
    <arg name="mav_name" default="tx_uav" />

    <node pkg="imu_mocap_fusion" type="imu_mocap_fusion_fake_node" name="imu_mocap_fusion_fake" output="screen">
        <!-- subscribe -->
        <remap from="~imu" to="/mavros/imu/data" />

        <!-- publish -->
        <remap from="~odom" to="/$(arg mav_name)/imu_mocap_fusion/odom" />
    </node>
</launch>